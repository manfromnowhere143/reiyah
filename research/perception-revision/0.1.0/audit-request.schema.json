{
  "$id": "urn:reiyah:perception-revision:audit-request:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "const": "reiyah.perception-revision.audit-request"
    },
    "comparison_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}(?![\\s\\S])",
      "type": "string"
    },
    "deletion_budget": {
      "maximum": 16384,
      "minimum": 0,
      "type": "integer"
    },
    "family": {
      "const": "reference_deletions"
    },
    "observation_basis": {
      "enum": [
        "hypothetical",
        "benchmark_reference",
        "supplied_external_records"
      ]
    },
    "observations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}(?![\\s\\S])",
            "type": "string"
          },
          "evidence_sha256": {
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
            "type": "string"
          },
          "object": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}(?![\\s\\S])",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "present",
              "absent"
            ]
          }
        },
        "required": [
          "anchor",
          "object",
          "outcome",
          "evidence_sha256"
        ],
        "type": "object"
      },
      "maxItems": 16384,
      "type": "array"
    },
    "reference_context_sha256": {
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
      "type": "string"
    },
    "version": {
      "const": "0.1.0"
    }
  },
  "required": [
    "artifact_id",
    "version",
    "comparison_id",
    "reference_context_sha256",
    "family",
    "deletion_budget",
    "observation_basis",
    "observations"
  ],
  "title": "Conditional reference observations and a bounded deletion family",
  "type": "object"
}
