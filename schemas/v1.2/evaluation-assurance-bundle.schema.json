{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reiyah.invalid/scientific-contract/1.2.0/evaluation-assurance-bundle.schema.json",
  "title": "Evaluation assurance bundle scientific contract",
  "description": "Gate A 1.2 static bindings for dataset governance, ODD, scenarios, tests, benchmark, and proposed safety-case structure. It provides no assurance, compliance, or deployment authority.",
  "type": "object",
  "allOf": [{"$ref": "common.schema.json#/$defs/recordHeader"}],
  "required": [
    "schema_id", "schema_version", "artifact_id", "version", "lifecycle_status", "lifecycle_history",
    "protocol_release_id", "created_at", "runtime_execution_authorized", "mission_release_id", "bundle_id",
    "dataset_governance", "odd_contract", "scenario_contract", "test_contracts", "benchmark_contract",
    "safety_case", "evidence_binding", "scientific_claim_authorized", "safety_claim_authorized",
    "compliance_claim_authorized", "deployment_authorized"
  ],
  "properties": {
    "schema_id": {"const": "https://schemas.reiyah.invalid/scientific-contract/1.2.0/evaluation-assurance-bundle.schema.json"},
    "record_kind": {"const": "evidence"},
    "mission_release_id": {"const": "reiyah.mission@1.1.0"},
    "bundle_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
    "dataset_governance": {"$ref": "#/$defs/datasetGovernance"},
    "odd_contract": {"$ref": "#/$defs/oddContract"},
    "scenario_contract": {"$ref": "#/$defs/scenarioContract"},
    "test_contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/testContract"}},
    "benchmark_contract": {"$ref": "#/$defs/benchmarkContract"},
    "safety_case": {"$ref": "#/$defs/safetyCase"},
    "evidence_binding": {"$ref": "common.schema.json#/$defs/evidenceGapBinding"},
    "scientific_claim_authorized": {"const": false},
    "safety_claim_authorized": {"const": false},
    "compliance_claim_authorized": {"const": false},
    "deployment_authorized": {"const": false}
  },
  "$defs": {
    "datasetGovernance": {
      "type": "object",
      "required": ["dataset_id", "version", "provenance_ref", "license_disposition", "ethics_review", "private_data_ingestion_authorized", "synthetic_only"],
      "properties": {
        "dataset_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
        "version": {"const": "1.2.0"},
        "provenance_ref": {"$ref": "common.schema.json#/$defs/versionedReference"},
        "license_disposition": {"const": "synthetic_original"},
        "ethics_review": {"$ref": "common.schema.json#/$defs/assumptionAssessment"},
        "private_data_ingestion_authorized": {"const": false},
        "synthetic_only": {"const": true}
      },
      "additionalProperties": false
    },
    "oddContract": {
      "type": "object",
      "required": ["odd_id", "version", "inclusion_rule_refs", "exclusion_rule_refs", "exit_condition_rule_refs", "boundary_state"],
      "properties": {
        "odd_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
        "version": {"const": "1.2.0"},
        "inclusion_rule_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/ruleReference"}},
        "exclusion_rule_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/ruleReference"}},
        "exit_condition_rule_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/ruleReference"}},
        "boundary_state": {"const": "proposed"}
      },
      "additionalProperties": false
    },
    "scenarioContract": {
      "type": "object",
      "required": ["scenario_set_id", "version", "generation_rule_ref", "coverage_rule_ref", "post_hoc_relabeling_prohibited"],
      "properties": {
        "scenario_set_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
        "version": {"const": "1.2.0"},
        "generation_rule_ref": {"$ref": "common.schema.json#/$defs/ruleReference"},
        "coverage_rule_ref": {"$ref": "common.schema.json#/$defs/ruleReference"},
        "post_hoc_relabeling_prohibited": {"const": true}
      },
      "additionalProperties": false
    },
    "testContract": {
      "type": "object",
      "required": ["test_id", "version", "input_fixture_ref", "oracle_rule_ref", "expected_disposition", "runtime_execution_authorized"],
      "properties": {
        "test_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
        "version": {"const": "1.2.0"},
        "input_fixture_ref": {"$ref": "common.schema.json#/$defs/versionedReference"},
        "oracle_rule_ref": {"$ref": "common.schema.json#/$defs/ruleReference"},
        "expected_disposition": {"enum": ["pass", "reject"]},
        "runtime_execution_authorized": {"const": false}
      },
      "additionalProperties": false
    },
    "benchmarkContract": {
      "type": "object",
      "required": ["benchmark_id", "version", "metric_contract_refs", "comparator_refs", "evaluation_protocol_ref", "claim_disposition"],
      "properties": {
        "benchmark_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
        "version": {"const": "1.2.0"},
        "metric_contract_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/ruleReference"}},
        "comparator_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/versionedReference"}},
        "evaluation_protocol_ref": {"$ref": "common.schema.json#/$defs/versionedReference"},
        "claim_disposition": {"const": "proposed"}
      },
      "additionalProperties": false
    },
    "hazard": {
      "type": "object",
      "required": ["hazard_id", "description", "mitigation_rule_refs", "residual_risk_state"],
      "properties": {
        "hazard_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
        "description": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "mitigation_rule_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/ruleReference"}},
        "residual_risk_state": {"enum": ["unmeasured", "unknown"]}
      },
      "additionalProperties": false
    },
    "assuranceClaim": {
      "type": "object",
      "required": ["claim_id", "claim_type", "statement", "status", "hazard_refs", "evidence_binding"],
      "properties": {
        "claim_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
        "claim_type": {"enum": ["scientific", "safety", "standards", "benchmark"]},
        "statement": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "status": {"const": "proposed"},
        "hazard_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/stableIdentifier"}, "uniqueItems": true},
        "evidence_binding": {"$ref": "common.schema.json#/$defs/evidenceGapBinding"}
      },
      "additionalProperties": false
    },
    "safetyCase": {
      "type": "object",
      "required": ["case_id", "version", "hazards", "claims", "status", "operator_acceptance_inferred"],
      "properties": {
        "case_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
        "version": {"const": "1.2.0"},
        "hazards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hazard"}},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assuranceClaim"}},
        "status": {"const": "proposed"},
        "operator_acceptance_inferred": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
