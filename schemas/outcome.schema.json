{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reiyah.invalid/gate-a/1.0.0/outcome.schema.json",
  "title": "Outcome object",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "object_id",
    "object_kind",
    "version",
    "lifecycle_status",
    "lifecycle_history",
    "protocol_release_id",
    "context_rules",
    "encounter_id",
    "physical_object_id",
    "measurement_window",
    "decision_refs",
    "intervention_refs",
    "outcome_definition_id",
    "measurements",
    "censoring",
    "validity",
    "provenance"
  ],
  "properties": {
    "schema_id": {
      "const": "https://schemas.reiyah.invalid/gate-a/1.0.0/outcome.schema.json"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "artifact_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "object_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "object_kind": {
      "const": "outcome"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "lifecycle_status": {
      "$ref": "common.schema.json#/$defs/lifecycleStatus"
    },
    "lifecycle_history": {
      "$ref": "common.schema.json#/$defs/lifecycleHistory"
    },
    "protocol_release_id": {
      "$ref": "common.schema.json#/$defs/releaseIdentifier"
    },
    "context_rules": {"$ref": "common.schema.json#/$defs/contextRules"},
    "encounter_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "physical_object_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "measurement_window": {
      "$ref": "common.schema.json#/$defs/timeInterval"
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/objectReference"
          },
          {
            "properties": {
              "object_kind": {
                "const": "decision"
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "intervention_refs": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/objectReference"
          },
          {
            "properties": {
              "object_kind": {
                "const": "intervention"
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "outcome_definition_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["measurement_id", "value"],
        "properties": {
          "measurement_id": {
            "$ref": "common.schema.json#/$defs/stableIdentifier"
          },
          "value": {
            "$ref": "common.schema.json#/$defs/scalarMeasurement"
          }
        },
        "additionalProperties": false
      }
    },
    "censoring": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "enum": ["not_censored", "right_censored", "left_censored", "interval_censored", "unknown"]
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/stringMeasurement"
        }
      },
      "additionalProperties": false
    },
    "validity": {
      "$ref": "common.schema.json#/$defs/validityAssessment"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "enum": ["corrected", "retracted"]
          }
        },
        "required": ["lifecycle_status"]
      },
      "then": {
        "properties": {
          "lifecycle_history": {
            "contains": {
              "properties": {
                "status": {
                  "enum": ["corrected", "retracted"]
                },
                "prior_artifact": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/priorArtifactReference"
                    },
                    {
                      "properties": {
                        "record_kind": {
                          "const": "outcome"
                        },
                        "schema_id": {
                          "const": "https://schemas.reiyah.invalid/gate-a/1.0.0/outcome.schema.json"
                        }
                      }
                    }
                  ]
                }
              },
              "required": ["status", "prior_artifact"]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
