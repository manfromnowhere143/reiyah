{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reiyah.invalid/gate-a/1.1.0/research-function-registry.schema.json",
  "title": "HARBOR research function registry",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "registry_id",
    "version",
    "as_of_date",
    "program_name",
    "lifecycle_status",
    "authority",
    "architecture_only",
    "runtime_authorized",
    "functions",
    "dependency_order",
    "prohibited_shortcuts"
  ],
  "properties": {
    "schema_id": {
      "const": "https://schemas.reiyah.invalid/gate-a/1.1.0/research-function-registry.schema.json"
    },
    "schema_version": {"const": "1.1.0"},
    "artifact_id": {"const": "reiyah.artifact.research-function-registry-1.1.0"},
    "registry_id": {"const": "reiyah.research-function-registry.harbor"},
    "version": {"const": "1.1.0"},
    "as_of_date": {"$ref": "common.schema.json#/$defs/calendarDate"},
    "program_name": {"const": "HARBOR"},
    "lifecycle_status": {"const": "proposed"},
    "authority": {"const": "operator_unaccepted_architecture"},
    "architecture_only": {"const": true},
    "runtime_authorized": {"const": false},
    "functions": {
      "type": "array",
      "minItems": 12,
      "items": {"$ref": "#/$defs/researchFunction"}
    },
    "dependency_order": {
      "type": "array",
      "minItems": 12,
      "items": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
      "uniqueItems": true
    },
    "prohibited_shortcuts": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "contractReference": {
      "type": "object",
      "required": ["contract_id", "kind", "schema_id", "required", "availability"],
      "properties": {
        "contract_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
        "kind": {
          "enum": [
            "question",
            "source",
            "construct",
            "study_design",
            "dataset",
            "split",
            "odd",
            "scenario",
            "preregistration",
            "observation",
            "belief",
            "decision",
            "intervention",
            "outcome",
            "joint_performance",
            "policy_evaluation",
            "uncertainty",
            "transfer",
            "worst_group",
            "result",
            "evidence",
            "review"
          ]
        },
        "schema_id": {
          "oneOf": [
            {"type": "string", "format": "uri"},
            {"type": "null"}
          ]
        },
        "required": {"type": "boolean"},
        "availability": {
          "enum": ["gate_a_defined", "gate_b_candidate", "not_authorized"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {"const": "gate_a_defined"}
            },
            "required": ["availability"]
          },
          "then": {
            "properties": {
              "schema_id": {"type": "string", "format": "uri"}
            }
          },
          "else": {
            "properties": {
              "schema_id": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "decisionBoundary": {
      "type": "object",
      "required": ["may_advance_when", "must_stop_when", "operator_review_required"],
      "properties": {
        "may_advance_when": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "uniqueItems": true
        },
        "must_stop_when": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "uniqueItems": true
        },
        "operator_review_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "researchFunction": {
      "type": "object",
      "required": [
        "function_id",
        "sequence",
        "name",
        "purpose",
        "lifecycle_status",
        "depends_on",
        "inputs",
        "outputs",
        "required_methods",
        "quality_controls",
        "decision_boundary"
      ],
      "properties": {
        "function_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
        "sequence": {"type": "integer", "minimum": 1},
        "name": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "purpose": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "lifecycle_status": {"const": "proposed"},
        "depends_on": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/contractReference"},
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/contractReference"},
          "uniqueItems": true
        },
        "required_methods": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "uniqueItems": true
        },
        "quality_controls": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
          "uniqueItems": true
        },
        "decision_boundary": {"$ref": "#/$defs/decisionBoundary"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
