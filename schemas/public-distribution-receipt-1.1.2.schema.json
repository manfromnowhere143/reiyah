{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reiyah.invalid/gate-a/1.1.2/public-distribution-receipt.schema.json",
  "title": "Reiyah public distribution receipt 1.1.2 successor",
  "description": "Append-only evidence for a successor static-packet distribution. It binds that event's fresh rights observation, preserves the prior receipt and prior published index as immutable history, and creates no Gate A, scientific, safety, compliance, publication, or GA-17 authority.",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "receipt_id",
    "version",
    "recorded_at",
    "lifecycle_status",
    "custody_profile_ref",
    "source_ledger_ref",
    "frontier_discovery_register_ref",
    "distribution_inventory_ref",
    "rights_revalidation_ref",
    "published_index_ref",
    "validation_report_ref",
    "published_repository_url",
    "published_ref",
    "published_git_commit",
    "published_at",
    "rights_observation_age_seconds",
    "distributed_payloads",
    "attribution_fulfillment",
    "remote_readback",
    "receipt_sequence",
    "history_policy",
    "prior_receipt_ref",
    "operator_distribution_authorized",
    "distribution_authorization",
    "distribution_authorization_scope",
    "distribution_executed",
    "receipt_is_append_only_successor",
    "runtime_execution_authorized",
    "ga17_status",
    "gate_a_acceptance_conferred",
    "scientific_publication_acceptance_conferred",
    "scientific_support_claimed",
    "compliance_claimed",
    "limitations"
  ],
  "properties": {
    "schema_id": {
      "const": "https://schemas.reiyah.invalid/gate-a/1.1.2/public-distribution-receipt.schema.json"
    },
    "schema_version": {
      "const": "1.1.2"
    },
    "artifact_id": {
      "const": "reiyah.artifact.public-distribution-receipt-1.1.2"
    },
    "receipt_id": {
      "const": "reiyah.public-distribution-receipt.documentation-continuity-publication"
    },
    "version": {
      "const": "1.1.2"
    },
    "recorded_at": {
      "$ref": "https://schemas.reiyah.invalid/gate-a/1.0.0/common.schema.json#/$defs/timestamp"
    },
    "lifecycle_status": {
      "const": "proposed"
    },
    "custody_profile_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/artifactReference"
        },
        {
          "properties": {
            "artifact_id": {"const": "reiyah.artifact.public-evidence-custody-profile-1.1.0"},
            "version": {"const": "1.1.0"},
            "path": {"const": "evidence/public-evidence-custody-profile-1.1.0.json"}
          }
        }
      ]
    },
    "source_ledger_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/artifactReference"
        },
        {
          "properties": {
            "artifact_id": {"const": "reiyah.artifact.source-ledger-1.1.0"},
            "version": {"const": "1.1.0"},
            "path": {"const": "evidence/source-ledger-1.1.0.json"}
          }
        }
      ]
    },
    "frontier_discovery_register_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/artifactReference"
        },
        {
          "properties": {
            "artifact_id": {"const": "reiyah.artifact.frontier-discovery-register-1.1.0"},
            "version": {"const": "1.1.0"},
            "path": {"const": "evidence/frontier-discovery-register-1.1.0.json"}
          }
        }
      ]
    },
    "distribution_inventory_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/artifactReference"
        },
        {
          "properties": {
            "artifact_id": {"const": "reiyah.artifact.public-distribution-inventory-1.1.0"},
            "version": {"const": "1.1.0"},
            "path": {"const": "evidence/public-distribution-inventory-1.1.0.json"}
          }
        }
      ]
    },
    "rights_revalidation_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/artifactReference"
        },
        {
          "properties": {
            "artifact_id": {
              "const": "reiyah.artifact.public-rights-revalidation-2026-08-24-1.1.2"
            },
            "version": {
              "const": "1.1.2"
            },
            "path": {
              "const": "evidence/public-rights-revalidation-2026-08-24-1.1.2.json"
            }
          }
        }
      ]
    },
    "published_index_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/artifactReference"
        },
        {
          "properties": {
            "artifact_id": {
              "const": "reiyah.artifact.gate-a-index-1.1.2"
            },
            "version": {
              "const": "1.1.2"
            },
            "path": {
              "const": "gate/GATE_A_EVIDENCE_INDEX.json"
            }
          }
        }
      ]
    },
    "validation_report_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/artifactReference"
        },
        {
          "properties": {
            "artifact_id": {
              "const": "reiyah.validation-report.gate-a-1.1.2"
            },
            "version": {
              "const": "1.1.2"
            },
            "path": {
              "const": "gate/validation-reports/gate-a-validation-1.1.2.json"
            }
          }
        }
      ]
    },
    "published_repository_url": {
      "const": "https://github.com/manfromnowhere143/reiyah"
    },
    "published_ref": {
      "const": "refs/heads/main"
    },
    "published_git_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "published_at": {
      "$ref": "https://schemas.reiyah.invalid/gate-a/1.0.0/common.schema.json#/$defs/timestamp"
    },
    "rights_observation_age_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600
    },
    "distributed_payloads": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/distributedPayload"
      },
      "uniqueItems": true
    },
    "attribution_fulfillment": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/attributionFulfillment"
      },
      "uniqueItems": true
    },
    "remote_readback": {
      "type": "object",
      "required": [
        "verified_at",
        "verification_method",
        "repository_visibility",
        "default_branch",
        "commit_reachable",
        "tree_contains_exact_index",
        "tree_contains_exact_validation_report",
        "all_distributed_payloads_retrievable"
      ],
      "properties": {
        "verified_at": {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.0.0/common.schema.json#/$defs/timestamp"
        },
        "verification_method": {
          "const": "authenticated_github_api_and_git_remote"
        },
        "repository_visibility": {
          "const": "public"
        },
        "default_branch": {
          "const": "main"
        },
        "commit_reachable": {
          "const": true
        },
        "tree_contains_exact_index": {
          "const": true
        },
        "tree_contains_exact_validation_report": {
          "const": true
        },
        "all_distributed_payloads_retrievable": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "receipt_sequence": {
      "const": 3
    },
    "history_policy": {
      "const": "append_only_linear"
    },
    "prior_receipt_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/artifactReference"
        },
        {
          "properties": {
            "artifact_id": {
              "const": "reiyah.artifact.public-distribution-receipt-1.1.1"
            },
            "version": {
              "const": "1.1.1"
            },
            "path": {
              "const": "gate/public-distribution-receipts/reiyah.public-distribution-receipt-1.1.1.json"
            },
            "sha256": {
              "const": "sha256:6156a35d3dfb2c4f0d46cbf48845867da6c942b69ed734a4056ae1e36910aa11"
            },
            "byte_size": {
              "const": 7565
            }
          }
        }
      ]
    },
    "operator_distribution_authorized": {
      "const": true
    },
    "distribution_authorization": {
      "$ref": "#/$defs/successorDistributionAuthorization"
    },
    "distribution_authorization_scope": {
      "const": "static_public_repository_distribution"
    },
    "distribution_executed": {
      "const": true
    },
    "receipt_is_append_only_successor": {
      "const": true
    },
    "runtime_execution_authorized": {
      "const": false
    },
    "ga17_status": {
      "const": "not_evaluated"
    },
    "gate_a_acceptance_conferred": {
      "const": false
    },
    "scientific_publication_acceptance_conferred": {
      "const": false
    },
    "scientific_support_claimed": {
      "const": false
    },
    "compliance_claimed": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "https://schemas.reiyah.invalid/gate-a/1.0.0/common.schema.json#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "successorDistributionAuthorization": {
      "type": "object",
      "required": [
        "basis_state",
        "recorded_date",
        "authorized_action",
        "scope_limit",
        "operator_identity_authentication",
        "ga17_effect",
        "gate_a_acceptance_effect",
        "scientific_publication_acceptance_effect",
        "runtime_execution_effect"
      ],
      "properties": {
        "basis_state": {
          "const": "observed_current_operator_instruction"
        },
        "recorded_date": {
          "const": "2026-08-24"
        },
        "authorized_action": {
          "const": "publish_exact_static_gate_a_1.1.2_documentation_continuity_successor"
        },
        "scope_limit": {
          "const": "Exact static Gate A 1.1.2 documentation-and-continuity successor packet and the unchanged four eligible retained payloads; no new scientific evidence, private data, runtime, deployment, or unauthorized source payloads."
        },
        "operator_identity_authentication": {
          "const": "not_evaluated"
        },
        "ga17_effect": {
          "const": "not_evaluated"
        },
        "gate_a_acceptance_effect": {
          "const": "none"
        },
        "scientific_publication_acceptance_effect": {
          "const": "none"
        },
        "runtime_execution_effect": {
          "const": "none"
        }
      },
      "additionalProperties": false
    },
    "attributionFulfillment": {
      "type": "object",
      "required": [
        "source_ref",
        "notice_path",
        "attribution_present"
      ],
      "properties": {
        "source_ref": {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/sourceReference"
        },
        "notice_path": {
          "const": "NOTICE"
        },
        "attribution_present": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "distributedPayload": {
      "type": "object",
      "required": [
        "source_ref",
        "payload"
      ],
      "properties": {
        "source_ref": {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/sourceReference"
        },
        "payload": {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/payloadBinding"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
