{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reiyah.invalid/gate-a/1.0.0/gate-a-index.schema.json",
  "title": "Hash-bearing Gate A architecture index",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "index_id",
    "version",
    "as_of_date",
    "lifecycle_status",
    "architecture_status",
    "operator_acceptance_state",
    "operator_decision_binding",
    "artifacts",
    "exclusions",
    "validation_profile",
    "known_good_expectation",
    "known_bad_expectation",
    "runtime_authorized"
  ],
  "properties": {
    "schema_id": {"const": "https://schemas.reiyah.invalid/gate-a/1.0.0/gate-a-index.schema.json"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "artifact_id": {"const": "reiyah.artifact.gate-a-index-1.0.0"},
    "index_id": {"const": "reiyah.gate-a-evidence-index"},
    "version": {"const": "1.0.0"},
    "as_of_date": {"const": "2026-08-22"},
    "lifecycle_status": {"const": "proposed"},
    "architecture_status": {"const": "architecture_complete"},
    "operator_acceptance_state": {
      "description": "The hash-bound candidate index remains unaccepted; any later decision is an external append-only record that binds these bytes.",
      "const": "unaccepted"
    },
    "operator_decision_binding": {
      "description": "Null prevents a decision/index digest cycle. External decision records are intentionally excluded from this index.",
      "type": "null"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "media_type", "digest_algorithm", "artifact"],
        "properties": {
          "role": {
            "enum": [
              "repository_contract",
              "repository_overview",
              "repository_metadata",
              "session_handoff",
              "scientific_charter",
              "claims_and_non_claims",
              "preimplementation_gate",
              "architecture_specification",
              "glossary",
              "validation_specification",
              "source_policy",
              "mission_manifest",
              "protocol_manifest",
              "protocol_definition_registry",
              "manifest_release_ledger",
              "source_ledger",
              "retained_source",
              "standards_crosswalk",
              "threat_model",
              "mathematical_specification",
              "status_model",
              "schema",
              "fixture_catalog",
              "known_good_fixture",
              "known_bad_fixture",
              "offline_validator",
              "index_builder",
              "validation_report",
              "architecture_diagram",
              "acceptance_procedure",
              "operator_decision_template"
            ]
          },
          "media_type": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
          },
          "digest_algorithm": {"const": "sha256"},
          "artifact": {
            "allOf": [
              {"$ref": "common.schema.json#/$defs/artifactReference"},
              {"required": ["version"]}
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "exclusions": {
      "description": "Acyclic inventory exclusions. Exclusion never implies scientific or operator authority.",
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["exclusion_id", "match_kind", "path", "reason"],
        "properties": {
          "exclusion_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
          "match_kind": {"enum": ["exact", "prefix"]},
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9._/-]+$",
            "not": {"pattern": "(^|/)\\.\\.?(/|$)"}
          },
          "reason": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
        },
        "additionalProperties": false
      }
    },
    "validation_profile": {
      "type": "object",
      "required": ["entrypoint", "offline_required", "deterministic_required", "fail_closed_required"],
      "properties": {
        "entrypoint": {"const": "tools/validate_gate_a.py"},
        "offline_required": {"const": true},
        "deterministic_required": {"const": true},
        "fail_closed_required": {"const": true}
      },
      "additionalProperties": false
    },
    "known_good_expectation": {"const": "all_pass"},
    "known_bad_expectation": {"const": "all_fail_for_declared_reason"},
    "runtime_authorized": {"const": false}
  },
  "additionalProperties": false
}
