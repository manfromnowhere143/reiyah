{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reiyah.invalid/gate-a/1.2.0/operator-decision-record.schema.json",
  "title": "Hash-bound Gate A 1.2.0 operator decision record",
  "description": "Static interface for an external operator decision about one exact Gate A 1.2.0 architecture packet. Schema validity, a typed name, a digest, a signature, or a generated record does not authenticate identity or authority and does not itself create acceptance. Templates are deliberately invalid.",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "record_id",
    "version",
    "record_kind",
    "is_template",
    "gate_id",
    "mission_release_id",
    "protocol_release_id",
    "decision",
    "operator_identity",
    "authority_basis",
    "decided_at",
    "rationale",
    "risk_acknowledgements",
    "release_ledger_binding",
    "manifest_release_bindings",
    "architecture_completeness_binding",
    "validation_report_binding",
    "scientific_claims_accepted",
    "operator_acceptance_conferred_by_schema",
    "ga17_evaluated_by_schema",
    "runtime_execution_authorized",
    "decision_sequence",
    "history_policy",
    "supersedes_record_id",
    "supersedes_record_sha256"
  ],
  "properties": {
    "schema_id": {
      "const": "https://schemas.reiyah.invalid/gate-a/1.2.0/operator-decision-record.schema.json"
    },
    "schema_version": {
      "const": "1.2.0"
    },
    "artifact_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "record_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "version": {
      "const": "1.2.0"
    },
    "record_kind": {
      "const": "operator_gate_decision"
    },
    "is_template": {
      "const": false
    },
    "gate_id": {
      "const": "reiyah.gate-a"
    },
    "mission_release_id": {
      "const": "reiyah.mission@1.1.0"
    },
    "protocol_release_id": {
      "const": "reiyah.protocol.harbor-gate-a@1.2.0"
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected",
        "deferred"
      ]
    },
    "operator_identity": {
      "description": "Stable operator identifier supplied by the operator. This field is not self-authenticating.",
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/stableIdentifier"
        },
        {
          "pattern": "^operator\\.[a-z0-9][a-z0-9._-]+$"
        }
      ]
    },
    "authority_basis": {
      "description": "Human-authored basis for authority over this exact Gate A architecture decision. Independent identity and authority verification remains external to this record.",
      "type": "string",
      "minLength": 40,
      "maxLength": 2000,
      "pattern": "\\S",
      "not": {
        "pattern": "(?:[Rr][Ee][Pp][Ll][Aa][Cc][Ee]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr]|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Uu][Nn][Vv][Ee][Rr][Ii][Ff][Ii][Ee][Dd])"
      }
    },
    "decided_at": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "pattern": "Z$"
        }
      ]
    },
    "rationale": {
      "description": "Decision-specific reasoning, including the disposition of unresolved risks and unknowns.",
      "type": "string",
      "minLength": 80,
      "maxLength": 8000,
      "pattern": "\\S",
      "not": {
        "pattern": "(?:[Rr][Ee][Pp][Ll][Aa][Cc][Ee]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr]|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd])"
      }
    },
    "risk_acknowledgements": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Validation is an integrity signal, not operator acceptance.",
          "Architecture acceptance does not support scientific, safety, compliance, causal, readiness, performance, or superiority claims.",
          "Retained external material remains an untrusted evidence source, not Reiyah authority.",
          "Gate A acceptance does not authorize runtime, deployment, private-data ingestion, model execution, cloud execution, or physical control.",
          "A repository record, typed name, signature, checksum, or consensus does not independently authenticate operator identity or authority."
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "Validation is an integrity signal, not operator acceptance."
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "const": "Architecture acceptance does not support scientific, safety, compliance, causal, readiness, performance, or superiority claims."
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "const": "Retained external material remains an untrusted evidence source, not Reiyah authority."
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "const": "Gate A acceptance does not authorize runtime, deployment, private-data ingestion, model execution, cloud execution, or physical control."
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "const": "A repository record, typed name, signature, checksum, or consensus does not independently authenticate operator identity or authority."
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "release_ledger_binding": {
      "$ref": "#/$defs/releaseLedgerBinding"
    },
    "manifest_release_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/missionReleaseBinding"
          },
          {
            "$ref": "#/$defs/protocolReleaseBinding"
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "$ref": "#/$defs/missionReleaseBinding"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/protocolReleaseBinding"
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "architecture_completeness_binding": {
      "$ref": "#/$defs/indexBinding"
    },
    "validation_report_binding": {
      "$ref": "#/$defs/validationReportBinding"
    },
    "scientific_claims_accepted": {
      "description": "A Gate A architecture decision never accepts a scientific claim.",
      "const": false
    },
    "operator_acceptance_conferred_by_schema": {
      "description": "Schema validity cannot create operator acceptance.",
      "const": false
    },
    "ga17_evaluated_by_schema": {
      "description": "A schema or validator cannot evaluate GA-17.",
      "const": false
    },
    "runtime_execution_authorized": {
      "const": false
    },
    "decision_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "history_policy": {
      "const": "append_only_linear"
    },
    "supersedes_record_id": {
      "description": "Immediate prior decision identifier; null only for sequence one.",
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/stableIdentifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes_record_sha256": {
      "description": "Digest of the immediate prior decision bytes; null only for sequence one.",
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/sha256Digest"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "indexBinding": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/artifactReference"
        },
        {
          "required": [
            "schema_id",
            "version"
          ],
          "properties": {
            "artifact_id": {
              "const": "reiyah.artifact.gate-a-index-1.2.0"
            },
            "path": {
              "const": "gate/GATE_A_EVIDENCE_INDEX.json"
            },
            "schema_id": {
              "const": "https://schemas.reiyah.invalid/gate-a/1.2.0/gate-a-index.schema.json"
            },
            "version": {
              "const": "1.2.0"
            }
          }
        }
      ]
    },
    "validationReportBinding": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/artifactReference"
        },
        {
          "required": [
            "schema_id",
            "version"
          ],
          "properties": {
            "artifact_id": {
              "const": "reiyah.validation-report.gate-a-1.2.0"
            },
            "path": {
              "const": "gate/validation-reports/gate-a-validation-1.2.0.json"
            },
            "schema_id": {
              "const": "https://schemas.reiyah.invalid/gate-a/1.2.0/validation-report.schema.json"
            },
            "version": {
              "const": "1.2.0"
            }
          }
        }
      ]
    },
    "releaseLedgerBinding": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/artifactReference"
        },
        {
          "required": [
            "schema_id",
            "version"
          ],
          "properties": {
            "artifact_id": {
              "const": "reiyah.artifact.manifest-release-ledger-1.2.0"
            },
            "path": {
              "const": "manifests/manifest-release-ledger.json"
            },
            "schema_id": {
              "const": "https://schemas.reiyah.invalid/gate-a/1.2.0/manifest-release-ledger.schema.json"
            },
            "version": {
              "const": "1.2.0"
            }
          }
        }
      ]
    },
    "missionReleaseBinding": {
      "type": "object",
      "required": [
        "release_id",
        "artifact"
      ],
      "properties": {
        "release_id": {
          "const": "reiyah.mission@1.1.0"
        },
        "artifact": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/artifactReference"
            },
            {
              "required": [
                "schema_id",
                "version"
              ],
              "properties": {
                "artifact_id": {
                  "const": "reiyah.artifact.mission-1.1.0"
                },
                "path": {
                  "const": "manifests/mission/reiyah-mission-1.1.0.json"
                },
                "schema_id": {
                  "const": "https://schemas.reiyah.invalid/gate-a/1.1.0/mission-manifest.schema.json"
                },
                "version": {
                  "const": "1.1.0"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "protocolReleaseBinding": {
      "type": "object",
      "required": [
        "release_id",
        "artifact"
      ],
      "properties": {
        "release_id": {
          "const": "reiyah.protocol.harbor-gate-a@1.2.0"
        },
        "artifact": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/artifactReference"
            },
            {
              "required": [
                "schema_id",
                "version"
              ],
              "properties": {
                "artifact_id": {
                  "const": "reiyah.artifact.protocol-1.2.0"
                },
                "path": {
                  "const": "manifests/protocol/harbor-gate-a-protocol-1.2.0.json"
                },
                "schema_id": {
                  "const": "https://schemas.reiyah.invalid/gate-a/1.2.0/protocol-manifest.schema.json"
                },
                "version": {
                  "const": "1.2.0"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision_sequence": {
            "const": 1
          }
        },
        "required": [
          "decision_sequence"
        ]
      },
      "then": {
        "properties": {
          "supersedes_record_id": {
            "type": "null"
          },
          "supersedes_record_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "decision_sequence": {
            "minimum": 2
          },
          "supersedes_record_id": {
            "$ref": "common.schema.json#/$defs/stableIdentifier"
          },
          "supersedes_record_sha256": {
            "$ref": "common.schema.json#/$defs/sha256Digest"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
