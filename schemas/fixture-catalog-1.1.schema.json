{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reiyah.invalid/gate-a/1.1.0/fixture-catalog.schema.json",
  "title": "Gate A 1.1 fixture catalog",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "catalog_id",
    "version",
    "offline_only",
    "all_known_good_must_pass",
    "all_known_bad_must_fail_for_declared_rule",
    "fixtures"
  ],
  "properties": {
    "schema_id": {"const": "https://schemas.reiyah.invalid/gate-a/1.1.0/fixture-catalog.schema.json"},
    "schema_version": {"const": "1.1.0"},
    "artifact_id": {"const": "reiyah.artifact.fixture-catalog-1.1.0"},
    "catalog_id": {"const": "reiyah.fixture-catalog.gate-a"},
    "version": {"const": "1.1.0"},
    "offline_only": {"const": true},
    "all_known_good_must_pass": {"const": true},
    "all_known_bad_must_fail_for_declared_rule": {"const": true},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fixture_id", "path", "classification", "expected_primary_rule_id"],
        "properties": {
          "fixture_id": {"$ref": "common.schema.json#/$defs/stableIdentifier"},
          "path": {"$ref": "common.schema.json#/$defs/relativeArtifactPath"},
          "classification": {"enum": ["known_good", "known_bad"]},
          "expected_primary_rule_id": {
            "oneOf": [
              {"type": "string", "pattern": "^GA-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
              {"type": "null"}
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"classification": {"const": "known_good"}}, "required": ["classification"]},
            "then": {"properties": {"expected_primary_rule_id": {"type": "null"}}},
            "else": {"properties": {"expected_primary_rule_id": {"type": "string", "pattern": "^GA-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
