{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reiyah.invalid/gate-a/1.2.0/frontier-discovery-fixture.schema.json",
  "title": "Reiyah frontier discovery register 1.2 fixture descriptor",
  "description": "A compact exact-byte fixture wrapper for replaying the canonical pointer-only frontier register or one reason-specific mutation. Mutation application is offline validation only.",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "fixture_id",
    "fixture_class",
    "target_schema_id",
    "base_artifact_ref",
    "mutations",
    "expected_outcome",
    "expected_failure",
    "fixture_creates_evidence",
    "fixture_creates_claims",
    "runtime_execution_authorized",
    "gate_b_authorized",
    "limitations"
  ],
  "properties": {
    "schema_id": {
      "const": "https://schemas.reiyah.invalid/gate-a/1.2.0/frontier-discovery-fixture.schema.json"
    },
    "schema_version": {
      "const": "1.2.0"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^reiyah\\.fixture\\.frontier-discovery\\.[a-z0-9-]+@1\\.2\\.0$"
    },
    "fixture_class": {
      "enum": [
        "known_good_frontier",
        "known_bad_frontier"
      ]
    },
    "target_schema_id": {
      "const": "https://schemas.reiyah.invalid/gate-a/1.2.0/frontier-discovery-register.schema.json"
    },
    "base_artifact_ref": {
      "const": {
        "artifact_id": "reiyah.artifact.frontier-discovery-register-1.2.0",
        "path": "evidence/frontier-discovery-register-1.2.0.json",
        "sha256": "sha256:e5e7f68c3f93d43553408873ca4ab4f9eb93ae5cd637c473b4f847a458000fac",
        "byte_size": 119407,
        "schema_id": "https://schemas.reiyah.invalid/gate-a/1.2.0/frontier-discovery-register.schema.json",
        "version": "1.2.0"
      }
    },
    "mutations": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/mutation"
      }
    },
    "expected_outcome": {
      "enum": [
        "accept",
        "reject"
      ]
    },
    "expected_failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/expectedFailure"
        }
      ]
    },
    "fixture_creates_evidence": {
      "const": false
    },
    "fixture_creates_claims": {
      "const": false
    },
    "runtime_execution_authorized": {
      "const": false
    },
    "gate_b_authorized": {
      "const": false
    },
    "limitations": {
      "const": [
        "This fixture is an offline deterministic schema replay descriptor and contains no source payload or empirical observation.",
        "Fixture acceptance or rejection creates no scientific evidence, safety claim, compliance claim, superiority claim, operator acceptance, runtime authority, or Gate B authority."
      ]
    }
  },
  "oneOf": [
    {
      "title": "Known good exact-byte replay",
      "properties": {
        "fixture_class": {
          "const": "known_good_frontier"
        },
        "mutations": {
          "const": []
        },
        "expected_outcome": {
          "const": "accept"
        },
        "expected_failure": {
          "type": "null"
        }
      },
      "required": [
        "fixture_class",
        "mutations",
        "expected_outcome",
        "expected_failure"
      ]
    },
    {
      "title": "Known bad singleton mutation replay",
      "properties": {
        "fixture_class": {
          "const": "known_bad_frontier"
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1
        },
        "expected_outcome": {
          "const": "reject"
        },
        "expected_failure": {
          "$ref": "#/$defs/expectedFailure"
        }
      },
      "required": [
        "fixture_class",
        "mutations",
        "expected_outcome",
        "expected_failure"
      ]
    }
  ],
  "$defs": {
    "mutation": {
      "type": "object",
      "required": [
        "operation",
        "json_pointer"
      ],
      "properties": {
        "operation": {
          "enum": [
            "remove",
            "replace"
          ]
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"
        },
        "value": true
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "replace"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          },
          "else": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "expectedFailure": {
      "type": "object",
      "required": [
        "rule_id",
        "rejection_layer",
        "schema_keyword",
        "instance_pointer",
        "reason"
      ],
      "properties": {
        "rule_id": {
          "enum": [
            "GA12-FRONTIER-PREDECESSOR-BINDING",
            "GA12-FRONTIER-IDENTITY-UNIQUE",
            "GA12-FRONTIER-CLAIM-NONADMISSION",
            "GA12-FRONTIER-PAYLOAD-NULL",
            "GA12-FRONTIER-PREDECESSOR-PREFIX",
            "GA12-FRONTIER-LIMITATION-REQUIRED",
            "GA12-FRONTIER-DYNAMIC-SOURCE-BINDING",
            "GA12-FRONTIER-PERSISTENT-VERSION-BINDING",
            "GA12-FRONTIER-INDEPENDENCE-LABEL"
          ]
        },
        "rejection_layer": {
          "const": "structural_schema"
        },
        "schema_keyword": {
          "enum": [
            "const",
            "required",
            "type"
          ]
        },
        "instance_pointer": {
          "type": "string",
          "pattern": "^(?:$|(?:/(?:[^~/]|~0|~1)*)+)$"
        },
        "reason": {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.0.0/common.schema.json#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$comment": "The fixture resolver must verify base_artifact_ref bytes before use, validate the unmodified base with zero diagnostics, deep copy it, apply at most one RFC 6901 mutation to an existing location, and require the exact declared canonical first schema keyword and instance pointer. A fixture result is integrity evidence only."
}
