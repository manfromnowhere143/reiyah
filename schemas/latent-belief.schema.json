{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reiyah.invalid/gate-a/1.0.0/latent-belief.schema.json",
  "title": "Latent belief object",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "object_id",
    "object_kind",
    "version",
    "lifecycle_status",
    "lifecycle_history",
    "protocol_release_id",
    "context_rules",
    "encounter_id",
    "physical_object_id",
    "event_time",
    "observation_refs",
    "state_space_id",
    "belief",
    "inference_specification_id",
    "validity",
    "provenance"
  ],
  "properties": {
    "schema_id": {
      "const": "https://schemas.reiyah.invalid/gate-a/1.0.0/latent-belief.schema.json"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "artifact_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "object_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "object_kind": {
      "const": "latent_belief"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "lifecycle_status": {
      "$ref": "common.schema.json#/$defs/lifecycleStatus"
    },
    "lifecycle_history": {
      "$ref": "common.schema.json#/$defs/lifecycleHistory"
    },
    "protocol_release_id": {
      "$ref": "common.schema.json#/$defs/releaseIdentifier"
    },
    "context_rules": {"$ref": "common.schema.json#/$defs/contextRules"},
    "encounter_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "physical_object_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "event_time": {
      "$ref": "common.schema.json#/$defs/timePoint"
    },
    "observation_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/objectReference"
          },
          {
            "properties": {
              "object_kind": {
                "const": "observation"
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "state_space_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "belief": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "components", "sum_tolerance"],
          "properties": {
            "state": {
              "const": "observed"
            },
            "components": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["state_id", "probability"],
                "properties": {
                  "state_id": {
                    "$ref": "common.schema.json#/$defs/stableIdentifier"
                  },
                  "probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "sum_tolerance": {
              "const": 0.000001
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "common.schema.json#/$defs/nonObservedMeasurement"
        }
      ]
    },
    "inference_specification_id": {
      "$ref": "common.schema.json#/$defs/stableIdentifier"
    },
    "validity": {
      "$ref": "common.schema.json#/$defs/validityAssessment"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "enum": ["corrected", "retracted"]
          }
        },
        "required": ["lifecycle_status"]
      },
      "then": {
        "properties": {
          "lifecycle_history": {
            "contains": {
              "properties": {
                "status": {
                  "enum": ["corrected", "retracted"]
                },
                "prior_artifact": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/priorArtifactReference"
                    },
                    {
                      "properties": {
                        "record_kind": {
                          "const": "latent_belief"
                        },
                        "schema_id": {
                          "const": "https://schemas.reiyah.invalid/gate-a/1.0.0/latent-belief.schema.json"
                        }
                      }
                    }
                  ]
                }
              },
              "required": ["status", "prior_artifact"]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
