{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reiyah.invalid/gate-a/1.2.0/public-distribution-receipt.schema.json",
  "title": "Reiyah Gate A 1.2.0 public distribution receipt",
  "description": "Append-only publisher record for a sequence-four static Gate A 1.2.0 distribution event. Remote readback fields are explicitly a publisher assertion, not independent transport verification. This receipt creates no scientific, safety, standards, legal, publication, acceptance, GA-17, runtime, cloud, deployment, private-data, model-execution, or physical-control authority.",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "receipt_id",
    "version",
    "recorded_at",
    "lifecycle_status",
    "distribution_event_id",
    "mission_release_id",
    "protocol_release_id",
    "custody_profile_ref",
    "source_ledger_ref",
    "frontier_discovery_register_ref",
    "distribution_inventory_ref",
    "rights_revalidation_ref",
    "published_index_ref",
    "validation_report_ref",
    "published_repository_url",
    "published_ref",
    "published_git_commit",
    "published_at",
    "oldest_capture_age_seconds",
    "distributed_payloads",
    "attribution_fulfillment",
    "remote_readback_assertion",
    "transport_verification_state",
    "transport_verification_record_ref",
    "receipt_sequence",
    "history_policy",
    "prior_receipt_ref",
    "operator_distribution_authorized",
    "distribution_authorization",
    "distribution_authorization_scope",
    "distribution_executed",
    "receipt_is_append_only_successor",
    "commit_topology",
    "runtime_execution_authorized",
    "ga17_status",
    "gate_a_acceptance_conferred",
    "scientific_publication_acceptance_conferred",
    "scientific_support_claimed",
    "compliance_claimed",
    "limitations"
  ],
  "properties": {
    "schema_id": {
      "const": "https://schemas.reiyah.invalid/gate-a/1.2.0/public-distribution-receipt.schema.json"
    },
    "schema_version": {
      "const": "1.2.0"
    },
    "artifact_id": {
      "const": "reiyah.artifact.public-distribution-receipt-1.2.0"
    },
    "receipt_id": {
      "const": "reiyah.public-distribution-receipt.gate-a-1.2.0-static-correction"
    },
    "version": {
      "const": "1.2.0"
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "lifecycle_status": {
      "const": "proposed"
    },
    "distribution_event_id": {
      "const": "reiyah.distribution-event.gate-a-1.2.0-static-correction"
    },
    "mission_release_id": {
      "const": "reiyah.mission@1.1.0"
    },
    "protocol_release_id": {
      "const": "reiyah.protocol.harbor-gate-a@1.2.0"
    },
    "custody_profile_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactBinding"
        },
        {
          "required": [
            "version"
          ],
          "properties": {
            "artifact_id": {
              "const": "reiyah.artifact.public-evidence-custody-profile-1.1.0"
            },
            "path": {
              "const": "evidence/public-evidence-custody-profile-1.1.0.json"
            },
            "version": {
              "const": "1.1.0"
            }
          }
        }
      ]
    },
    "source_ledger_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactBinding"
        },
        {
          "required": [
            "version"
          ],
          "properties": {
            "artifact_id": {
              "const": "reiyah.artifact.source-ledger-1.1.0"
            },
            "path": {
              "const": "evidence/source-ledger-1.1.0.json"
            },
            "version": {
              "const": "1.1.0"
            }
          }
        }
      ]
    },
    "frontier_discovery_register_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactBinding"
        },
        {
          "required": [
            "version"
          ],
          "properties": {
            "artifact_id": {
              "const": "reiyah.artifact.frontier-discovery-register-1.1.0"
            },
            "path": {
              "const": "evidence/frontier-discovery-register-1.1.0.json"
            },
            "version": {
              "const": "1.1.0"
            }
          }
        }
      ]
    },
    "distribution_inventory_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactBinding"
        },
        {
          "required": [
            "version"
          ],
          "properties": {
            "artifact_id": {
              "const": "reiyah.artifact.public-distribution-inventory-1.1.0"
            },
            "path": {
              "const": "evidence/public-distribution-inventory-1.1.0.json"
            },
            "version": {
              "const": "1.1.0"
            }
          }
        }
      ]
    },
    "rights_revalidation_ref": {
      "description": "Fresh event-specific rights observation retained before distribution; no rights record is created by this schema.",
      "allOf": [
        {
          "$ref": "#/$defs/artifactBinding"
        },
        {
          "required": [
            "schema_id",
            "version"
          ],
          "properties": {
            "artifact_id": {
              "const": "reiyah.artifact.public-rights-revalidation-2026-08-25-gate-a-static-correction-1.2.0"
            },
            "path": {
              "const": "evidence/public-rights-revalidation-2026-08-25-gate-a-static-correction-1.2.0.json"
            },
            "schema_id": {
              "const": "https://schemas.reiyah.invalid/gate-a/1.2.0/public-rights-revalidation.schema.json"
            },
            "version": {
              "const": "1.2.0"
            }
          }
        }
      ]
    },
    "published_index_ref": {
      "$ref": "#/$defs/indexBinding"
    },
    "validation_report_ref": {
      "$ref": "#/$defs/validationReportBinding"
    },
    "published_repository_url": {
      "const": "https://github.com/manfromnowhere143/reiyah"
    },
    "published_ref": {
      "const": "refs/heads/main"
    },
    "published_git_commit": {
      "$ref": "#/$defs/gitObjectId"
    },
    "published_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "oldest_capture_age_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600
    },
    "distributed_payloads": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/distributedPayload"
      },
      "$ref": "#/$defs/exactSourceCoverage"
    },
    "attribution_fulfillment": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/attributionFulfillment"
      },
      "$ref": "#/$defs/exactSourceCoverage"
    },
    "remote_readback_assertion": {
      "$ref": "#/$defs/publisherReadbackAssertion"
    },
    "transport_verification_state": {
      "description": "The receipt contains only a publisher assertion and is not independent transport verification.",
      "const": "asserted_unverified"
    },
    "transport_verification_record_ref": {
      "description": "Must remain null in the immutable receipt. A later independent observation binds this receipt in its own record.",
      "type": "null"
    },
    "receipt_sequence": {
      "const": 4
    },
    "history_policy": {
      "const": "append_only_linear"
    },
    "prior_receipt_ref": {
      "$ref": "#/$defs/priorReceiptBinding"
    },
    "operator_distribution_authorized": {
      "const": true
    },
    "distribution_authorization": {
      "$ref": "#/$defs/distributionAuthorization"
    },
    "distribution_authorization_scope": {
      "const": "exact_static_public_repository_distribution"
    },
    "distribution_executed": {
      "const": true
    },
    "receipt_is_append_only_successor": {
      "const": true
    },
    "commit_topology": {
      "type": "object",
      "required": [
        "published_git_commit_role",
        "receipt_bearing_commit_role",
        "receipt_bearing_commit_must_be_direct_child",
        "published_and_receipt_bearing_commits_must_differ",
        "packet_projection_index_report_must_remain_byte_identical",
        "receipt_bearing_commit_self_readback_claimed",
        "receipt_bearing_commit_readback_requires_later_append_only_observation"
      ],
      "properties": {
        "published_git_commit_role": {"const": "candidate_packet_commit"},
        "receipt_bearing_commit_role": {"const": "direct_child_event_artifact_commit"},
        "receipt_bearing_commit_must_be_direct_child": {"const": true},
        "published_and_receipt_bearing_commits_must_differ": {"const": true},
        "packet_projection_index_report_must_remain_byte_identical": {"const": true},
        "receipt_bearing_commit_self_readback_claimed": {"const": false},
        "receipt_bearing_commit_readback_requires_later_append_only_observation": {"const": true}
      },
      "additionalProperties": false
    },
    "runtime_execution_authorized": {
      "const": false
    },
    "ga17_status": {
      "const": "not_evaluated"
    },
    "gate_a_acceptance_conferred": {
      "const": false
    },
    "scientific_publication_acceptance_conferred": {
      "const": false
    },
    "scientific_support_claimed": {
      "const": false
    },
    "compliance_claimed": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      },
      "allOf": [
        {
          "contains": {
            "const": "Remote readback in this receipt is a publisher assertion, not an independently retained transport observation."
          }
        },
        {
          "contains": {
            "const": "Transport remains asserted_unverified until a distinct transport verification record binds independently retained observation bytes."
          }
        },
        {
          "contains": {
            "const": "Static public distribution does not accept Gate A, evaluate GA-17, or authorize runtime, cloud execution, deployment, private data, model execution, or physical control."
          }
        },
        {
          "contains": {
            "const": "Repository reachability and byte equality do not establish scientific validity, safety, standards compliance, legal sufficiency, publication acceptance, readiness, or superiority."
          }
        },
        {
          "contains": {
            "const": "The frontier discovery register remains pointer only and evidence ineligible."
          }
        },
        {
          "contains": {
            "const": "This receipt binds publication and publisher readback of C_packet only; it cannot claim readback of the C_receipt commit that contains its own bytes."
          }
        }
      ]
    }
  },
  "$defs": {
    "artifactBinding": {
      "type": "object",
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "byte_size",
        "version"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "common.schema.json#/$defs/stableIdentifier"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativeArtifactPath"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256Digest"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "schema_id": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semanticVersion"
        }
      },
      "additionalProperties": false
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "indexBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactBinding"
        },
        {
          "required": [
            "schema_id",
            "version"
          ],
          "properties": {
            "artifact_id": {
              "const": "reiyah.artifact.gate-a-index-1.2.0"
            },
            "path": {
              "const": "gate/GATE_A_EVIDENCE_INDEX.json"
            },
            "schema_id": {
              "const": "https://schemas.reiyah.invalid/gate-a/1.2.0/gate-a-index.schema.json"
            },
            "version": {
              "const": "1.2.0"
            }
          }
        }
      ]
    },
    "validationReportBinding": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactBinding"
        },
        {
          "required": [
            "schema_id",
            "version"
          ],
          "properties": {
            "artifact_id": {
              "const": "reiyah.validation-report.gate-a-1.2.0"
            },
            "path": {
              "const": "gate/validation-reports/gate-a-validation-1.2.0.json"
            },
            "schema_id": {
              "const": "https://schemas.reiyah.invalid/gate-a/1.2.0/validation-report.schema.json"
            },
            "version": {
              "const": "1.2.0"
            }
          }
        }
      ]
    },
    "sourceReference": {
      "type": "object",
      "required": [
        "source_id",
        "version"
      ],
      "properties": {
        "source_id": {
          "enum": [
            "src.iso.26262-1.2018.open-data",
            "src.iso.21448.2022.open-data",
            "src.iso-tr.21959-1.2020.open-data",
            "src.iso-pas.8800.2024.open-data"
          ]
        },
        "version": {
          "const": "1.1.0"
        }
      },
      "additionalProperties": false
    },
    "exactSourceCoverage": {
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "source_ref"
            ],
            "properties": {
              "source_ref": {
                "properties": {
                  "source_id": {
                    "const": "src.iso.26262-1.2018.open-data"
                  }
                },
                "required": [
                  "source_id"
                ]
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "source_ref"
            ],
            "properties": {
              "source_ref": {
                "properties": {
                  "source_id": {
                    "const": "src.iso.21448.2022.open-data"
                  }
                },
                "required": [
                  "source_id"
                ]
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "source_ref"
            ],
            "properties": {
              "source_ref": {
                "properties": {
                  "source_id": {
                    "const": "src.iso-tr.21959-1.2020.open-data"
                  }
                },
                "required": [
                  "source_id"
                ]
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "source_ref"
            ],
            "properties": {
              "source_ref": {
                "properties": {
                  "source_id": {
                    "const": "src.iso-pas.8800.2024.open-data"
                  }
                },
                "required": [
                  "source_id"
                ]
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "distributedPayload": {
      "type": "object",
      "required": [
        "source_ref",
        "payload"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/sourceReference"
        },
        "payload": {
          "$ref": "https://schemas.reiyah.invalid/gate-a/1.1.0/source-ledger.schema.json#/$defs/payloadBinding"
        }
      },
      "additionalProperties": false
    },
    "attributionFulfillment": {
      "type": "object",
      "required": [
        "source_ref",
        "notice_path",
        "attribution_present"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/sourceReference"
        },
        "notice_path": {
          "const": "NOTICE"
        },
        "attribution_present": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "publisherReadbackAssertion": {
      "description": "A publisher's self-attestation about its own readback. No field in this object is independent verification.",
      "type": "object",
      "required": [
        "asserted_at",
        "asserted_by",
        "assertion_basis",
        "observation_method",
        "observed_repository_url",
        "observed_ref",
        "observed_git_commit",
        "observed_index_sha256",
        "observed_validation_report_sha256",
        "repository_visibility",
        "default_branch",
        "commit_reachable",
        "tree_contains_exact_index",
        "tree_contains_exact_validation_report",
        "all_distributed_payloads_retrievable",
        "publisher_is_observer",
        "independent_observer",
        "independent_verification_claimed"
      ],
      "properties": {
        "asserted_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "asserted_by": {
          "$ref": "common.schema.json#/$defs/stableIdentifier"
        },
        "assertion_basis": {
          "const": "publisher_observation_of_published_remote"
        },
        "observation_method": {
          "enum": [
            "authenticated_github_api_and_git_remote",
            "authenticated_github_api",
            "git_remote"
          ]
        },
        "observed_repository_url": {
          "const": "https://github.com/manfromnowhere143/reiyah"
        },
        "observed_ref": {"const": "refs/heads/main"},
        "observed_git_commit": {"$ref": "#/$defs/gitObjectId"},
        "observed_index_sha256": {"$ref": "common.schema.json#/$defs/sha256Digest"},
        "observed_validation_report_sha256": {
          "$ref": "common.schema.json#/$defs/sha256Digest"
        },
        "repository_visibility": {
          "const": "public"
        },
        "default_branch": {
          "const": "main"
        },
        "commit_reachable": {
          "const": true
        },
        "tree_contains_exact_index": {
          "const": true
        },
        "tree_contains_exact_validation_report": {
          "const": true
        },
        "all_distributed_payloads_retrievable": {
          "const": true
        },
        "publisher_is_observer": {
          "const": true
        },
        "independent_observer": {
          "const": false
        },
        "independent_verification_claimed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "priorReceiptBinding": {
      "type": "object",
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "byte_size",
        "schema_id",
        "version"
      ],
      "properties": {
        "artifact_id": {
          "const": "reiyah.artifact.public-distribution-receipt-1.1.2"
        },
        "path": {
          "const": "gate/public-distribution-receipts/reiyah.public-distribution-receipt-1.1.2.json"
        },
        "sha256": {
          "const": "sha256:e7f3bedac49423d4ba042419056896c507d26ee2bd9a706981abf2131dcda19d"
        },
        "byte_size": {
          "const": 7621
        },
        "schema_id": {
          "const": "https://schemas.reiyah.invalid/gate-a/1.1.2/public-distribution-receipt.schema.json"
        },
        "version": {
          "const": "1.1.2"
        }
      },
      "additionalProperties": false
    },
    "distributionAuthorization": {
      "type": "object",
      "required": [
        "basis_state",
        "observed_at",
        "authorized_action",
        "scope_limit",
        "operator_identity_authentication",
        "ga17_effect",
        "gate_a_acceptance_effect",
        "scientific_publication_acceptance_effect",
        "runtime_execution_effect"
      ],
      "properties": {
        "basis_state": {
          "const": "observed_fresh_event_specific_operator_instruction"
        },
        "observed_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "authorized_action": {
          "const": "publish_exact_static_gate_a_1.2.0_correction_packet"
        },
        "scope_limit": {
          "const": "Exact static Gate A 1.2.0 correction packet and the unchanged four eligible retained payloads only; no new scientific evidence, runtime, cloud execution, deployment, private data, model execution, physical control, or unauthorized source payloads."
        },
        "operator_identity_authentication": {
          "const": "not_evaluated"
        },
        "ga17_effect": {
          "const": "not_evaluated"
        },
        "gate_a_acceptance_effect": {
          "const": "none"
        },
        "scientific_publication_acceptance_effect": {
          "const": "none"
        },
        "runtime_execution_effect": {
          "const": "none"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$comment": "Semantic validation resolves rights_revalidation_ref and both capture_manifest_ref values; oldest_capture_age_seconds equals published_at minus the oldest capture observation_completed_at and must remain within the rights maximum. published_git_commit and remote_readback_assertion.observed_git_commit both bind C_packet, never the receipt-bearing commit."
}
